# ==============================================================================
# BUS RESERVATION SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and adjust variables as needed.
# DO NOT commit real secrets, passwords, or production keys to source control!
# ==============================================================================

# Server & Flask Configuration
FLASK_APP=run.py
FLASK_ENV=production
FLASK_DEBUG=0
HOST=0.0.0.0
PORT=5000
SECRET_KEY=change-this-to-a-secure-random-secret-key-for-production

# Database Configuration
# ------------------------------------------------------------------------------
# Option 1: Managed PostgreSQL (Recommended for Render Public Deployment)
# Render provides DATABASE_URL automatically when you attach a PostgreSQL database.
# Example:
# DATABASE_URL=postgresql://user:password@hostname.render.com/database_name

# Option 2: Local MySQL (Optional for local development)
USE_MYSQL=False
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=bus_reservation_db

# Option 3: Local SQLite (Default fallback if neither DATABASE_URL nor USE_MYSQL is set)
# No configuration needed! Creates bus_reservation.db automatically.

# Payment Gateway Configuration (Razorpay)
# ------------------------------------------------------------------------------
# Set DEMO_PAYMENT_MODE=True to test the full checkout flow without real credentials.
# For live/test keys, provide your Razorpay credentials below:
DEMO_PAYMENT_MODE=True
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
