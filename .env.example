# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=bus-reservation-super-secret-key-2026-academic-project

# Database Configuration (MySQL)
# Default is SQLite for out-of-the-box zero config execution.
# To use your local MySQL server, set USE_MYSQL=True and configure below:
USE_MYSQL=False
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=bus_reservation_db

# Alternative direct connection string (if set, takes precedence):
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/bus_reservation_db

# Payment Configuration (Razorpay)
# If left empty, application seamlessly uses DEMO PAYMENT MODE with full simulation
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
DEMO_PAYMENT_MODE=True
