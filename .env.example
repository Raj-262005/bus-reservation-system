# ==============================================================================
# BUS RESERVATION SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and adjust variables as needed.
# DO NOT commit real secrets, passwords, or production keys to source control!
# ==============================================================================

# Server & Flask Configuration
FLASK_APP=run.py
FLASK_ENV=production
FLASK_DEBUG=0
HOST=0.0.0.0
PORT=5000
SECRET_KEY=change-this-to-a-secure-random-secret-key-for-production

# Database Configuration
# ------------------------------------------------------------------------------
# Option 1: Managed PostgreSQL (Recommended for Vercel & Render Public Deployments)
# On Vercel: Set DATABASE_URL in your Vercel Project Settings -> Environment Variables.
# Providers with generous free tiers: Neon (neon.tech), Supabase (supabase.com), Render PostgreSQL.
# Example:
# DATABASE_URL=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option 2: Local MySQL (Optional for local development)
USE_MYSQL=False
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=bus_reservation_db

# Option 3: Local SQLite (Default fallback for local development)
# Local: Creates bus_reservation.db in project root automatically.
# Vercel: If DATABASE_URL is not set, falls back to ephemeral /tmp/bus_reservation.db.
# Note: Data in /tmp resets when Vercel serverless containers recycle. Use Option 1 for persistence.

# Payment Gateway Configuration
# ------------------------------------------------------------------------------
# Set DEMO_PAYMENT_MODE=True for instant testing without needing real Razorpay credentials.
DEMO_PAYMENT_MODE=True
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Dynamic UPI QR Payment Settings
# ------------------------------------------------------------------------------
UPI_ID=rajthakare2005@oksbi
UPI_PAYEE_NAME=Raj Thakare

# GST / Tax Settings (5% standard rate for passenger bus transport in India)
GST_RATE=5.0

